# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# CLOUDINARY credentials are required to persist and optimize image uploads.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google and GitHub OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# SMTP Setup for Email Delivery
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"W2M Academy" <noreply@example.com>'

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Cloudinary Setup for Direct Profile Images and Banners
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# MongoDB Connection String for LMS persistence
MONGODB_URI=


# Database name is explicit: test locally, codin only in production.
MONGODB_DB_NAME=test
NODE_ENV=development
PORT=3000
OUTBOUND_ENABLED=false

# Optional separate-machine hosting. Leave empty/default for the existing combined app.
# VITE_API_BASE_URL is public and embedded in the frontend build; never put secrets here.
VITE_API_BASE_URL=
# Frontend origin stays in APP_URL. PUBLIC_API_URL is the browser-visible API origin.
PUBLIC_API_URL=
# Exact comma-separated frontend origins. Defaults to APP_URL; never use *.
CORS_ORIGINS=
# false runs Express as an API only; true preserves the existing hosting setup.
SERVE_FRONTEND=true
