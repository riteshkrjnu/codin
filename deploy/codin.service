[Unit]
Description=CoDIN web application
After=network-online.target
Wants=network-online.target
[Service]
User=codin
Group=codin
WorkingDirectory=/opt/codin/current
EnvironmentFile=/etc/codin.env
ExecStart=/opt/codin/current/.tools/node/bin/node dist/server.cjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/codin
UMask=0077
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
